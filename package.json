{
  "name": "goat-counter",
  "type": "module",
  "version": "0.1.0",
  "description": "A typed, dependency-free GoatCounter client for modern browsers",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/goat-counter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/goat-counter.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/goat-counter/issues"
  },
  "keywords": [
    "analytics",
    "browser",
    "goatcounter",
    "nuxt",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./nuxt": "./dist/nuxt.js",
    "./runtime/nuxt-plugin": "./dist/runtime/nuxt-plugin.js",
    "./runtime/use-goat-counter": "./dist/runtime/use-goat-counter.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "@sxzz/eslint-config": "^8.6.0",
    "@sxzz/prettier-config": "^2.3.2",
    "@types/node": "^26.5.1",
    "@typescript/native-preview": "npm:typescript@~7.0.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "tsdown-preset-sxzz": "^0.7.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "prettier": "@sxzz/prettier-config"
}
